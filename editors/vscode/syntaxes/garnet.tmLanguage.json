        },
        {
          "match": "\\]",
          "name": "punctuation.section.brackets.end.garnet"
        },
        {
          "match": ",",
          "name": "punctuation.separator.comma.garnet"
        },
        {
          "match": ";",
          "name": "punctuation.terminator.statement.garnet"
        },
        {
          "match": ":",
          "name": "punctuation.separator.colon.garnet"
        },
        {
          "match": "\\.",
          "name": "punctuation.accessor.garnet"
        }
      ]
    },
    "identifiers": {
      "match": "(?<![\\p{L}\\p{Nd}_])[\\p{L}_][\\p{L}\\p{Nd}_]*(?![\\p{L}\\p{Nd}_])",
      "name": "variable.other.garnet"
    }
  }
}
