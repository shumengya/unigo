{
  "name": "unigo-lang",
  "displayName": "UniGo",
  "description": "UniGo (.ug) 语言支持：语法高亮、括号匹配、注释、缩进",
  "version": "0.1.0",
  "publisher": "shumengya",
  "license": "MIT",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "unigo",
    "ug"
  ],
  "contributes": {
    "languages": [
      {
        "id": "unigo",
        "aliases": [
          "UniGo",
          "unigo"
        ],
        "extensions": [
          ".ug"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "unigo",
        "scopeName": "source.unigo",
        "path": "./syntaxes/unigo.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "unigo",
        "path": "./snippets/unigo.json"
      }
    ],
    "configurationDefaults": {
      "[unigo]": {
        "editor.insertSpaces": false,
        "editor.tabSize": 4
      }
    }
  },
  "scripts": {
    "build": "node scripts/build-grammar.js",
    "test": "node scripts/build-grammar.js && node test/tokenize.js",
    "package": "node scripts/build-grammar.js && npx --yes @vscode/vsce package --allow-missing-repository"
  },
  "devDependencies": {
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.2.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/shumengya/unigo",
    "directory": "editors/vscode"
  }
}
